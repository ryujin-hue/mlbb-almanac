{
  "name": "mlbb-meta-worker",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "dev:cron": "wrangler dev --test-scheduled",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --import ./tests/register-ts.mjs --test tests/*.test.ts",
    "build:web": "npm --prefix ../web install --no-audit --no-fund && npm --prefix ../web run build",
    "predeploy": "npm run build:web && npm run clean:redirects",
    "snapshot": "node --experimental-strip-types --import ./tests/register-ts.mjs ../tools/snapshot-static.mjs",
    "dev:mock": "node --experimental-strip-types --import ./tests/register-ts.mjs ../tools/dev-server.mjs",
    "clean:redirects": "node -e \"require('node:fs').rmSync('../site/_redirects',{force:true})\""
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261022.1",
    "typescript": "^5.6.3",
    "wrangler": "^4.39.0"
  }
}
